<% @meta_title = @account.login %>
<% @meta_description = "#{@account.login} on GitHub Sponsors, showing their profile, sponsorships, and featured works" %>

<div class="container-sm">
  <ul class="nav nav-tabs my-3">
    <%= render 'tabs' %>
  </ul>

  <div class="d-flex align-items-center my-3">
    <img src="<%= @account.avatar_url %>" alt="<%= @account.login %>" class="rounded-circle me-3" height="64" width="64">
    <div>
      <h1 class="h3 mb-0">
        <%= link_to @account.login, @account.html_url, target: :_blank, class: 'text-decoration-hover' %>
        <% if @account.kind %>
          <small class="text-muted fs-6"><%= @account.kind %></small>
        <% end %>
      </h1>
    </div>
  </div>

  <% if @account.data.present? %>
    <% if @account.description.present? %>
      <p>
        <%= @account.description %>
      </p>
    <% end %>

    <% if @account.funding_links.any? %>
      <p><small class='text-muted'>
      Funding Links: <% @account.funding_links.each_with_index do |url,i| %><%= ', ' if i > 0 %><%= link_to(url, sanitize_user_url(url), target: :_blank) %><% end %>
      </small></p>
    <% end %>

    <ul class='list-unstyled'>
      <% ['name', 'location', 'company', 'kind', 'followers', 'following', 'total_stars', 'repositories_count', 'created_at', 'updated_at', 'last_synced_at'].each do |key| %>
        <% value = @account.data[key] %>
        <% next if value.blank? %>
        <li>
          <strong><%= key.humanize %>:</strong> <%= value %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @account.has_sponsors_listing && @account.sponsor_profile.present? %>
    <h2 class="h4 mt-4">GitHub Sponsors Profile</h2>

    <p>
      <%= simple_format @account.sponsor_profile['bio'] %>
    </p>

    <ul class='list-unstyled'>
      <li>
        <strong>Current Sponsors:</strong> <%= number_with_delimiter @account.current_sponsors %><%= '+' if @account.active_sponsors_count == 5000 %>
      </li>
      <li>
        <strong>Past Sponsors:</strong> <%= number_with_delimiter @account.past_sponsors %>
      </li>
      <li>
        <strong>Total Sponsors:</strong> <%= number_with_delimiter @account.total_sponsors %>
      </li>
      <li>
        <strong>Minimum Sponsorship:</strong> <%= number_to_currency (@account.minimum_sponsorship_amount || 1) %>
      </li>
    </ul>

    <% if @account.sponsor_profile['featured_works'].present? %>
      <h5 class="mt-4">Featured Works</h5>
      <div class='row'>
        <% @account.sponsor_profile['featured_works'].each do |work| %>
          <div class='col-md-4 mb-3'>
            <div class='card h-100'>
              <div class='card-body'>
                <h5><%= link_to work['title'], work['url'], target: :_blank %></h5>
                <p><%= work['description'] %></p>
                <small class='text-muted'>
                  Language: <%= work['language'] %> - 
                  Stars: <%= work['stars'] %>
                </small>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>  

    <% if @account.sponsorships_as_maintainer.active.any? %>
      <h5 class="mt-4">Active Sponsors</h5>

      <div class="row row-cols-3 row-cols-sm-4 row-cols-md-6 g-2 mb-3">
        <% @account.sponsorships_as_maintainer.active.includes(:funder).each do |sponsorship| %>
          <%= render 'account_card', login: sponsorship.funder.login %>
        <% end %>
      </div>
    <% end %>

    <% if @account.sponsorships_as_maintainer.inactive.any? %>
      <h5 class="mt-4">Past Sponsors</h5>

      <div class="row row-cols-3 row-cols-sm-4 row-cols-md-6 g-2 mb-3">
        <% @account.sponsorships_as_maintainer.inactive.includes(:funder).each do |sponsorship| %>
          <%= render 'account_card', login: sponsorship.funder.login %>
        <% end %>
      </div>
    <% end %>

  <% end %>

  <% if @mutual_accounts.present? %>
    <h5 class="mt-4">Sponsoring Each Other</h5>
    <div class="row row-cols-3 row-cols-sm-4 row-cols-md-6 g-2 mb-3">
      <% @mutual_accounts.each do |mutual| %>
        <%= render 'account_card', login: mutual.login %>
      <% end %>
    </div>
  <% end %>

  <% if @cluster %>
    <h5 class="mt-4">Sponsorship Cluster</h5>
    <div class="d-flex flex-wrap gap-2 mb-3">
      <% (@cluster - [@account.login]).each do |login| %>
        <%= render 'account_avatar', login: login, size: 50, shape: 'rounded-circle' %>
      <% end %>
    </div>
  <% end %>

  <% if @account.sponsorships_as_maintainer.any? %>
    <p class="text-muted"><small>
      Sponsored by <%= @account.sponsorships_as_maintainer.includes(:funder).group_by { |s| s.funder.kind }.map { |kind, sponsorships| "#{sponsorships.count} #{kind ? kind.pluralize(sponsorships.count) : 'unknown'}" }.join(', ') %>
    </small></p>
  <% end %>

  <% if @account.sponsorships_as_funder.any? %>

    <% if @account.sponsorships_as_funder.active.any? %>
      <h5 class="mt-4">Active Sponsorships</h5>

      <div class="row row-cols-3 row-cols-sm-4 row-cols-md-6 g-2 mb-3">
        <% @account.sponsorships_as_funder.active.includes(:maintainer).each do |sponsorship| %>
          <%= render 'account_card', login: sponsorship.maintainer.login %>
        <% end %>
      </div>
    <% end %>

    <% if @account.sponsorships_as_funder.inactive.any? %>
      <h5 class="mt-4">Past Sponsorships</h5>

      <div class="row row-cols-3 row-cols-sm-4 row-cols-md-6 g-2 mb-3">
        <% @account.sponsorships_as_funder.inactive.includes(:maintainer).each do |sponsorship| %>
          <%= render 'account_card', login: sponsorship.maintainer.login %>
        <% end %>
      </div>
    <% end %>

    <p class="text-muted"><small>
      Sponsoring <%= @account.sponsorships_as_funder.includes(:maintainer).group_by { |s| s.maintainer.kind }.map { |kind, sponsorships| "#{sponsorships.count} #{kind ? kind.pluralize(sponsorships.count) : 'unknown'}" }.join(', ') %>
      &middot;
      <%= link_to 'View all on GitHub', "https://github.com/#{@account.login}?tab=sponsoring", target: :_blank %>
    </small></p>
  <% end %>

  <p class="text-muted mt-4"><small>
    <%= link_to 'View JSON representation', api_v1_account_path(@account), target: :_blank %>
  </small></p>
</div>