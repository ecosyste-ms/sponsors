<% size = local_assigns.fetch(:size, 40) %>
<% shape = local_assigns.fetch(:shape, 'rounded') %>
<%= link_to account_path(login), title: login do %>
  <img src="https://avatars.githubusercontent.com/<%= login %>" class="<%= shape %>" height="<%= size %>" width="<%= size %>" alt="<%= login %>">
<% end %>
